{
  "name": "derhead",
  "private": true,
  "workspaces": [
    ".",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/verify-web-assets.js",
    "deploy": "wrangler deploy",
    "dev:web": "npm run dev -w @derhead/web",
    "dev:api": "npm run dev -w @derhead/api",
    "dev:mcp": "npm run dev -w @derhead/mcp",
    "deploy:web": "wrangler deploy",
    "deploy:api": "wrangler deploy -c apps/api/wrangler.jsonc",
    "deploy:mcp": "wrangler deploy -c apps/mcp/wrangler.jsonc",
    "deploy:all": "npm run deploy:web && npm run deploy:api && npm run deploy:mcp",
    "verify:deployments": "node scripts/verify-deployments.js",
    "typecheck": "npm run typecheck -w @derhead/api && npm run typecheck -w @derhead/mcp",
    "db:migrate:local": "wrangler d1 execute derhead-hometwin --local --file=packages/db/migrations/0001_hometwin_schema.sql -c apps/mcp/wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 execute derhead-hometwin --remote --file=packages/db/migrations/0001_hometwin_schema.sql -c apps/mcp/wrangler.jsonc"
  },
  "devDependencies": {
    "wrangler": "^4.98.0"
  }
}
